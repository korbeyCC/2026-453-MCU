# =============================================================================
*.obj
*.elf
*.bin
*.hex
*.map
*.lst
*.d
*.axf
*.iex
*.dep
*.dbg
*.crf
*.htm
*.lnp
*.sct
*.idx
*.o
*.su
*.i
*.s
*.ii
*.bc

# =============================================================================
# IDE配置文件 (IDE Configuration Files)
# =============================================================================
# Keil MDK-ARM
*.uvgui.*
*.uvguix.*
*.uvoptx
*.uvprojx.bak

# VS Code
/.vscode/launch.json
/.settings

# EIDE Plugin
/.eide/log
/.eide.usr.ctx.json
.eide/eide.json
.eide/eide.yml

# =============================================================================
# 项目输出目录 (Project Output Directories)
# =============================================================================
/build
/bin
/obj
/out

# =============================================================================
# MDK-ARM项目特定文件 (MDK-ARM Project Specific)
# =============================================================================
# 用户特定的项目配置
MDK-ARM/12-MYTEST-Base by DCMI2LCD-Before FreeRtos.uvguix.YEYY4
MDK-ARM/12-MYTEST-Base by DCMI2LCD-Before FreeRtos.uvprojx

# MDK-ARM生成的目录和文件
MDK-ARM/**/RTE/
MDK-ARM/**/DebugConfig/
MDK-ARM/**/Listings/
MDK-ARM/**/Objects/

# =============================================================================
# CMSIS和包管理 (CMSIS & Package Management)
# =============================================================================
.cmsis/
*.pack
*.ept
*.eide-template

# =============================================================================
# 系统和临时文件 (System & Temporary Files)
# =============================================================================
# Windows系统文件
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# 临时文件
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*~

# 编辑器备份文件
*.orig
*.rej

# =============================================================================
# 多媒体文件 (Media Files)
# =============================================================================
*.MP4
*.mp4
*.avi
*.mov
*.wmv

# =============================================================================
# 项目特定文件 (Project Specific Files)
# =============================================================================
# Keil项目文件
*.uvproj
*.uvopt
*.uvprojx
*.uvoptx

# VS Code工作区文件
*.code-workspace

# 编译输出目录
/Objects/
/Listings/
/DebugConfig/
/RTE/

# 如果有其他项目特定的忽略文件，请在此处添加
技术文档/
硬件/